# ---------------------------------------------------------------------------
# KitabDostu — environment variables
# Copy this file to `.env.local` (git-ignored) and adjust the values.
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# ---------------------------------------------------------------------------

# Base URL of the backend REST API — this is the ONLY thing you change when the
# backend repository (Node.js + PostgreSQL) is ready.
# Leave it empty to run the app entirely on the built-in mock API.
#   Android emulator -> http://10.0.2.2:4000/api/v1
#   iOS simulator    -> http://localhost:4000/api/v1
#   Physical device  -> http://<your-lan-ip>:4000/api/v1
EXPO_PUBLIC_API_BASE_URL=

# Force the in-memory mock API even when EXPO_PUBLIC_API_BASE_URL is set.
# "true" | "false"
EXPO_PUBLIC_USE_MOCK_API=true

# Artificial latency (ms) applied to every mock request, so loading states,
# skeletons and optimistic updates are actually visible while developing.
EXPO_PUBLIC_MOCK_LATENCY_MS=320

# Default UI language on first launch: "az" | "en"
EXPO_PUBLIC_DEFAULT_LOCALE=az
