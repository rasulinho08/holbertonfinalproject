# ---------------------------------------------------------------------------
# KitabDostu — environment
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. Expo only exposes variables prefixed with
# EXPO_PUBLIC_ to the app bundle, and it inlines them at **bundle time** — so
# after changing anything here you must restart Metro:
#
#   npx expo start --clear
# ---------------------------------------------------------------------------

# Base URL of the backend. REQUIRED — there is no bundled mock any more, so the
# app cannot start without one. The backend lives at:
#   https://github.com/rasulinho08/holbertonfinalproject-backend
#
# Pick the line that matches where you are running the app:
#
#   Web / iOS simulator (same machine)  http://localhost:4000/api/v1
#   Android emulator                    http://10.0.2.2:4000/api/v1
#   Physical phone (Expo Go or APK)     http://<your-LAN-IP>:4000/api/v1
#   Deployed backend                    https://your-host/api/v1
#
# `localhost` on a phone means *the phone*, not your computer. Find your LAN IP
# with `ipconfig` — the "IPv4 Address" under your Wi-Fi adapter. See MOBILE.md.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Default UI language on first launch: "az" | "en"
EXPO_PUBLIC_DEFAULT_LOCALE=az

# --- Google sign-in (optional) ---------------------------------------------
# Leave these unset and the "Continue with Google" button is simply not shown.
# A button that cannot sign anyone in is worse than no button.
#
# Create the client at https://console.cloud.google.com:
#   APIs & Services -> Credentials -> Create OAuth client ID
#
#   Web application       -> EXPO_PUBLIC_GOOGLE_CLIENT_ID
#     Authorised JavaScript origins and redirect URIs: the site's origin,
#     e.g. https://holbertonfinalproject0.mamishovrasul028.workers.dev
#     and http://localhost:8081 for local web.
#     The backend's GOOGLE_OAUTH_CLIENT_ID must be this same id.
#
#   Android (APK/AAB builds) uses Google's native account picker with the
#   *web* id above, so there is nothing to set here for it. Google still needs
#   an "Android" OAuth client in the same project: package az.kitabdostu.app
#   and the signing SHA-1 that `eas credentials` prints. Expo Go cannot do
#   Google sign-in on Android.
#
#   EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID is only the browser-flow fallback and
#   can stay empty.
#
#   iOS     -> EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID
#
# These are inlined at build time, so changing one means a rebuild.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
