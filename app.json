{
  "expo": {
    "name": "KitabDostu",
    "slug": "kitabdostu",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kitabdostu",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1116"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "az.kitabdostu.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "az.kitabdostu.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0E1116"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "KitabDostu",
      "shortName": "KitabDostu",
      "themeColor": "#1E3A5F",
      "backgroundColor": "#0E1116",
      "display": "standalone",
      "lang": "az"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "KitabDostu sitatları kitab şəkillərindən çıxarmaq üçün qalereyaya giriş istəyir.",
          "cameraPermission": "KitabDostu sitat çəkmək üçün kameraya giriş istəyir."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KitabDostu kitabın barkodunu oxumaq üçün kameradan istifadə edir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "b32565cb-6998-48ea-adb4-dd825f2f6a12"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/b32565cb-6998-48ea-adb4-dd825f2f6a12"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
